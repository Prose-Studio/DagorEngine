// The game's UI fonts (settings.blk initUiFonts): fonts.dynFont.blk, made from fontgen.blk by the content build, and
// the .ttf files of this dir, rasterized at runtime into the dynamic font textures
fontbins{
  name:t=ui/fonts
}

refHRes:i=1080

dynamicGen{
  texCount:i=2
  texSz:i=2048
  prefix:t="ui"
}
