// Render entities every client creates before the world renderer (gameparams.blk commonClientScenes)
entity{
  _template:t="render_settings"
}

entity{
  _template:t="blurred_ui"
}

entity{
  _template:t="dynamic_lighting"
}

entity{
  _template:t="ui_nodes"
}

// the asset manager (gamelibs.txt assets_import): the game builds what it loads from develop/assets and reloads what
// changes there (Windows clients outside Rel; elsewhere the entity does nothing)
entity{
  _template:t="base_asset_manager"
  asset__baseFolder:t="develop/assets" // relative to the project dir
}
