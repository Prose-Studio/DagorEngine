{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "$comment": [
    "The game's trees (cmake --list-presets): <host>-client and <host>-dedicated build the game into ../game, the",
    "client's tree its content too (cmake --build --preset <host>-client-content). Workflows: <host>-dedicated-test",
    "(the tests that need no GPU), <host>-client-package and <host>-dedicated-package. Local presets go in",
    "CMakeUserPresets.json."
  ],
  "include": [
    "../../../prog/cmake/presets/base.json"
  ],
  "configurePresets": [
    {
      "name": "project",
      "hidden": true,
      "$comment": "the engine this project is built with (DAGOR_ENGINE_ROOT; dng.py new writes the path)",
      "environment": {
        "DAGOR_ENGINE_ROOT": "${sourceDir}/../../../prog/.."
      },
      "cacheVariables": {
        "DAGOR_VARIANT": "game",
        "DAGOR_DAS_AOT": "ON"
      }
    },
    {
      "name": "dedicated",
      "hidden": true,
      "cacheVariables": {
        "DAGOR_DEDICATED": "ON"
      }
    },
    {
      "name": "aot-compiler",
      "hidden": true,
      "$comment": "the game's daScript AOT compiler, a host program the other trees build and run",
      "cacheVariables": {
        "DAGOR_DAS_AOT": "OFF",
        "DAGOR_DAS_AOT_COMPILER": "ON"
      }
    },
    {
      "name": "windows-client",
      "inherits": [
        "project",
        "windows"
      ]
    },
    {
      "name": "windows-dedicated",
      "inherits": [
        "dedicated",
        "project",
        "windows"
      ]
    },
    {
      "name": "windows-aot-compiler",
      "inherits": [
        "aot-compiler",
        "project",
        "windows"
      ]
    },
    {
      "name": "linux-client",
      "inherits": [
        "project",
        "linux"
      ]
    },
    {
      "name": "linux-dedicated",
      "inherits": [
        "dedicated",
        "project",
        "linux"
      ]
    },
    {
      "name": "linux-aot-compiler",
      "inherits": [
        "aot-compiler",
        "project",
        "linux"
      ]
    },
    {
      "name": "macos-client",
      "inherits": [
        "project",
        "macos"
      ]
    },
    {
      "name": "macos-dedicated",
      "inherits": [
        "dedicated",
        "project",
        "macos"
      ]
    },
    {
      "name": "macos-aot-compiler",
      "inherits": [
        "aot-compiler",
        "project",
        "macos"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "windows-client",
      "configurePreset": "windows-client",
      "configuration": "Dev"
    },
    {
      "name": "windows-dedicated",
      "configurePreset": "windows-dedicated",
      "configuration": "Dev"
    },
    {
      "name": "windows-aot-compiler",
      "configurePreset": "windows-aot-compiler",
      "configuration": "Dev"
    },
    {
      "name": "windows-client-content",
      "configurePreset": "windows-client",
      "configuration": "Dev",
      "targets": [
        "content"
      ]
    },
    {
      "name": "windows-client-rel",
      "configurePreset": "windows-client",
      "configuration": "Rel"
    },
    {
      "name": "windows-dedicated-rel",
      "configurePreset": "windows-dedicated",
      "configuration": "Rel"
    },
    {
      "name": "linux-client",
      "configurePreset": "linux-client",
      "configuration": "Dev"
    },
    {
      "name": "linux-dedicated",
      "configurePreset": "linux-dedicated",
      "configuration": "Dev"
    },
    {
      "name": "linux-aot-compiler",
      "configurePreset": "linux-aot-compiler",
      "configuration": "Dev"
    },
    {
      "name": "linux-client-content",
      "configurePreset": "linux-client",
      "configuration": "Dev",
      "targets": [
        "content"
      ]
    },
    {
      "name": "linux-client-rel",
      "configurePreset": "linux-client",
      "configuration": "Rel"
    },
    {
      "name": "linux-dedicated-rel",
      "configurePreset": "linux-dedicated",
      "configuration": "Rel"
    },
    {
      "name": "macos-client",
      "configurePreset": "macos-client",
      "configuration": "Dev"
    },
    {
      "name": "macos-dedicated",
      "configurePreset": "macos-dedicated",
      "configuration": "Dev"
    },
    {
      "name": "macos-aot-compiler",
      "configurePreset": "macos-aot-compiler",
      "configuration": "Dev"
    },
    {
      "name": "macos-client-content",
      "configurePreset": "macos-client",
      "configuration": "Dev",
      "targets": [
        "content"
      ]
    },
    {
      "name": "macos-client-rel",
      "configurePreset": "macos-client",
      "configuration": "Rel"
    },
    {
      "name": "macos-dedicated-rel",
      "configurePreset": "macos-dedicated",
      "configuration": "Rel"
    }
  ],
  "testPresets": [
    {
      "name": "windows-dedicated",
      "configurePreset": "windows-dedicated",
      "inherits": "dagor"
    },
    {
      "name": "windows-dedicated-ci",
      "configurePreset": "windows-dedicated",
      "inherits": "dagor-ci"
    },
    {
      "name": "windows-client",
      "configurePreset": "windows-client",
      "inherits": "dagor"
    },
    {
      "name": "linux-dedicated",
      "configurePreset": "linux-dedicated",
      "inherits": "dagor"
    },
    {
      "name": "linux-dedicated-ci",
      "configurePreset": "linux-dedicated",
      "inherits": "dagor-ci"
    },
    {
      "name": "linux-client",
      "configurePreset": "linux-client",
      "inherits": "dagor"
    },
    {
      "name": "macos-dedicated",
      "configurePreset": "macos-dedicated",
      "inherits": "dagor"
    },
    {
      "name": "macos-dedicated-ci",
      "configurePreset": "macos-dedicated",
      "inherits": "dagor-ci"
    },
    {
      "name": "macos-client",
      "configurePreset": "macos-client",
      "inherits": "dagor"
    }
  ],
  "packagePresets": [
    {
      "name": "windows-client",
      "configurePreset": "windows-client",
      "configurations": [
        "Rel"
      ]
    },
    {
      "name": "windows-dedicated",
      "configurePreset": "windows-dedicated",
      "configurations": [
        "Rel"
      ]
    },
    {
      "name": "linux-client",
      "configurePreset": "linux-client",
      "configurations": [
        "Rel"
      ]
    },
    {
      "name": "linux-dedicated",
      "configurePreset": "linux-dedicated",
      "configurations": [
        "Rel"
      ]
    },
    {
      "name": "macos-client",
      "configurePreset": "macos-client",
      "configurations": [
        "Rel"
      ]
    },
    {
      "name": "macos-dedicated",
      "configurePreset": "macos-dedicated",
      "configurations": [
        "Rel"
      ]
    }
  ],
  "workflowPresets": [
    {
      "name": "windows-dedicated-test",
      "steps": [
        {
          "type": "configure",
          "name": "windows-dedicated"
        },
        {
          "type": "build",
          "name": "windows-dedicated"
        },
        {
          "type": "test",
          "name": "windows-dedicated-ci"
        }
      ]
    },
    {
      "name": "windows-client-package",
      "steps": [
        {
          "type": "configure",
          "name": "windows-client"
        },
        {
          "type": "build",
          "name": "windows-client-rel"
        },
        {
          "type": "package",
          "name": "windows-client"
        }
      ]
    },
    {
      "name": "windows-dedicated-package",
      "steps": [
        {
          "type": "configure",
          "name": "windows-dedicated"
        },
        {
          "type": "build",
          "name": "windows-dedicated-rel"
        },
        {
          "type": "package",
          "name": "windows-dedicated"
        }
      ]
    },
    {
      "name": "linux-dedicated-test",
      "steps": [
        {
          "type": "configure",
          "name": "linux-dedicated"
        },
        {
          "type": "build",
          "name": "linux-dedicated"
        },
        {
          "type": "test",
          "name": "linux-dedicated-ci"
        }
      ]
    },
    {
      "name": "linux-client-package",
      "steps": [
        {
          "type": "configure",
          "name": "linux-client"
        },
        {
          "type": "build",
          "name": "linux-client-rel"
        },
        {
          "type": "package",
          "name": "linux-client"
        }
      ]
    },
    {
      "name": "linux-dedicated-package",
      "steps": [
        {
          "type": "configure",
          "name": "linux-dedicated"
        },
        {
          "type": "build",
          "name": "linux-dedicated-rel"
        },
        {
          "type": "package",
          "name": "linux-dedicated"
        }
      ]
    },
    {
      "name": "macos-dedicated-test",
      "steps": [
        {
          "type": "configure",
          "name": "macos-dedicated"
        },
        {
          "type": "build",
          "name": "macos-dedicated"
        },
        {
          "type": "test",
          "name": "macos-dedicated-ci"
        }
      ]
    },
    {
      "name": "macos-client-package",
      "steps": [
        {
          "type": "configure",
          "name": "macos-client"
        },
        {
          "type": "build",
          "name": "macos-client-rel"
        },
        {
          "type": "package",
          "name": "macos-client"
        }
      ]
    },
    {
      "name": "macos-dedicated-package",
      "steps": [
        {
          "type": "configure",
          "name": "macos-dedicated"
        },
        {
          "type": "build",
          "name": "macos-dedicated-rel"
        },
        {
          "type": "package",
          "name": "macos-dedicated"
        }
      ]
    }
  ]
}
