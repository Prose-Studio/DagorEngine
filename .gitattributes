* text=auto
*.cpp text
*.h text
*.cc text
*.c text
*.hpp text
*.inl text
*.inc text
*.py text
*.nut text
*.as text
*.tis text
*.png binary
*.jpg binary
*.wasm binary
*.sh text eol=lf
*.plist text eol=lf

active_matter/prog/gameBase/gamedata/dx12_cache.blk binary
enlisted/prog/gameBase/gamedata/dx12_cache.blk binary
skyquake/prog/gameBase/gamebase/gamedata/dx12_cache.blk binary

# tools data the cdk install copies into tools/, byte for byte
prog/tools/toolsData/** -text

# daScript tool tests that compare their fixtures' text with the tools' output: LF on every checkout
prog/1stPartyLibs/daScript/utils/gen1-to-gen2/** text eol=lf
prog/1stPartyLibs/daScript/utils/requirefix/** text eol=lf

# Quirrel's test suite, whose expected diagnostics were made from CRLF checkouts (a token's width counts the CR): CRLF
# on every checkout
prog/1stPartyLibs/quirrel/quirrel/testData/** text eol=crlf
