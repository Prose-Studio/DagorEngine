# The tree's options. A build tree is one variant of the engine, which its preset names (DAGOR_VARIANT): the variant
# gives the options below their defaults and decides which programs the default build makes
# (prog/CMakeLists.txt). Every option applies to every target of the tree.
include_guard(GLOBAL)

# dagor_check_choice(<name> <value> <choice>...): fails unless <value> is one of the choices
function(dagor_check_choice name value)
  if(NOT value IN_LIST ARGN)
    list(JOIN ARGN ", " choices)
    message(FATAL_ERROR "${name}='${value}' is not supported; use one of: ${choices}")
  endif()
endfunction()

# dagor_option(<name> <default> <doc> [CHOICES <value>...]): a cache option; with CHOICES, one of them
function(dagor_option name default doc)
  cmake_parse_arguments(PARSE_ARGV 3 arg "" "" "CHOICES")
  set(${name} "${default}" CACHE STRING "${doc}")
  if(arg_CHOICES)
    set_property(CACHE ${name} PROPERTY STRINGS ${arg_CHOICES})
    dagor_check_choice(${name} "${${name}}" ${arg_CHOICES})
  endif()
endfunction()

# dagor_config_option(<name> <default> <doc>): a list of configurations (Dev, Rel, IRel, Dbg), empty for none
function(dagor_config_option name default doc)
  set(${name} "${default}" CACHE STRING "${doc} (a list of Dev, Rel, IRel, Dbg)")
  foreach(config IN LISTS ${name})
    dagor_check_choice(${name} "${config}" Dev Rel IRel Dbg)
  endforeach()
endfunction()

# --- what the tree is ------------------------------------------------------------------------------------------------
dagor_option(DAGOR_VARIANT tests
  "What the tree builds: the unit tests, the content tools (cdk), the asset build on the shared kernel (assets), the GUI editors (editor), the 3ds Max plugins, dargbox, or a game (the trees of projects)"
  CHOICES tests cdk assets editor maxplug dargbox game)
option(DAGOR_DEDICATED "The game tree builds the dedicated server (no rendering)" OFF)
option(DAGOR_DAS_AOT_COMPILER "The game tree builds the game's daScript AOT compiler (a host program of its trees)" OFF)
option(DAGOR_BUILD_ALL "Build every library and program of the tree, not only those of the variant" OFF)
if((DAGOR_DEDICATED OR DAGOR_DAS_AOT_COMPILER) AND NOT DAGOR_VARIANT STREQUAL "game")
  message(FATAL_ERROR "DAGOR_DEDICATED and DAGOR_DAS_AOT_COMPILER are for game trees (DAGOR_VARIANT=game)")
endif()
if(DAGOR_DEDICATED AND DAGOR_DAS_AOT_COMPILER)
  message(FATAL_ERROR "The tree of the daScript AOT compiler (DAGOR_DAS_AOT_COMPILER) is not a dedicated server's")
endif()

# the defaults the variants differ in
set(_game OFF)
set(_client OFF)
set(_tools OFF)
set(_linux_server OFF) # the production servers: no checked containers, no stack protection, no profiler
if(DAGOR_VARIANT STREQUAL "game")
  set(_game ON)
  if(NOT DAGOR_DEDICATED AND NOT DAGOR_DAS_AOT_COMPILER)
    set(_client ON)
  endif()
  if(DAGOR_DEDICATED AND LINUX)
    set(_linux_server ON)
  endif()
elseif(NOT DAGOR_VARIANT STREQUAL "tests")
  set(_tools ON) # the tools: SSE2 on Windows, precise floating point, Bullet
endif()

# --- code generation -------------------------------------------------------------------------------------------------
set(_sse 2)
if(APPLE OR DAGOR_ARCH STREQUAL "e2k" OR (WIN32 AND NOT _tools) OR (LINUX AND _tools))
  set(_sse 4)
endif()
dagor_option(DAGOR_SSE ${_sse} "SSE level of x86_64 code: 2 or 4 (SSE4.1 + POPCNT)" CHOICES 2 4)
set(_fp fast)
if(_tools)
  set(_fp precise)
endif()
dagor_option(DAGOR_FP_MODEL ${_fp} "Floating point model" CHOICES fast precise strict)
# Linux x86_64 games build for Haswell, the minimum of the servers and the clients
set(_march "")
if(_game AND LINUX AND DAGOR_ARCH STREQUAL "x86_64")
  set(_march haswell)
endif()
dagor_option(DAGOR_MARCH "${_march}" "CPU the code is tuned for (-march of GCC and clang; empty for the compiler's default)")
dagor_option(DAGOR_CPP_STD 20 "C++ standard" CHOICES 20 23)
set(_kernel static)
if(DAGOR_VARIANT MATCHES "^(assets|editor)$")
  set(_kernel dynamic)
endif()
dagor_option(DAGOR_KERNEL_LINKAGE ${_kernel} "The kernel linked into each program (static) or shared as daKernel (dynamic)"
  CHOICES static dynamic)
set(_strict_aliasing OFF) # type-based alias analysis in every fast math build
if(DAGOR_FP_MODEL STREQUAL "fast")
  set(_strict_aliasing ON)
endif()
option(DAGOR_STRICT_ALIASING "Type-based alias analysis (-fstrict-aliasing)" ${_strict_aliasing})

# --- language features and checks per configuration ------------------------------------------------------------------
set(_exceptions "Dev;Dbg")
set(_checked "Dbg")
set(_stack_protection "Dev;Dbg")
if(_game)
  set(_exceptions "") # daNetGame's games have none
  set(_checked "Dev;Dbg")
elseif(DAGOR_VARIANT STREQUAL "tests")
  set(_exceptions "Dev;Rel;IRel;Dbg")
  set(_checked "Dev;Dbg")
elseif(DAGOR_VARIANT STREQUAL "maxplug")
  set(_exceptions "Dev;Rel;IRel;Dbg")
elseif(DAGOR_VARIANT STREQUAL "editor")
  set(_exceptions "Dev;Rel;IRel;Dbg") # daEditor3x and AssetViewer
  set(_checked "")
endif()
dagor_option(DAGOR_SANITIZE none "Sanitizer" CHOICES none address undefined thread leak memory)
if(_linux_server AND NOT DAGOR_SANITIZE STREQUAL "address")
  set(_checked "")
  set(_stack_protection "")
endif()
dagor_config_option(DAGOR_EXCEPTIONS_CONFIGS "${_exceptions}" "Configurations whose C++ code has exceptions enabled")
dagor_config_option(DAGOR_CHECKED_CONTAINERS_CONFIGS "${_checked}" "Configurations with bounds-checked containers (EASTL_DEBUG)")
dagor_config_option(DAGOR_STACK_PROTECTION_CONFIGS "${_stack_protection}" "Configurations with stack protection")
option(DAGOR_CATCH_SEH "Catch structured exceptions (/EHa) where exceptions are enabled (Windows)" OFF)
set(_rtti OFF)
if(DAGOR_VARIANT STREQUAL "maxplug")
  set(_rtti ON)
endif()
option(DAGOR_RTTI "C++ RTTI" ${_rtti})
# the logs of the games, the tests, csq and dargbox (their trees' kernel has them in Rel and IRel too)
set(_force_logs ${_game})
if(DAGOR_VARIANT MATCHES "^(tests|cdk|dargbox)$")
  set(_force_logs ON)
endif()
option(DAGOR_FORCE_LOGS "Keep debug logs in Rel and IRel" ${_force_logs})
option(DAGOR_WARNINGS_AS_ERRORS "Warnings of the strict (first-party) code are errors" ${_game})

# --- instrumentation and optimization --------------------------------------------------------------------------------
dagor_option(DAGOR_LTO OFF "Link-time optimization: OFF, thin or full" CHOICES OFF thin full)
option(DAGOR_LTO_DEVIRT "Whole-program devirtualization with LTO" ON)
option(DAGOR_COVERAGE "Clang source-based code coverage" OFF)
option(DAGOR_UNITY_BUILD "Unity (jumbo) builds of the targets that allow it" OFF)
if(DAGOR_COVERAGE AND NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
  message(FATAL_ERROR "DAGOR_COVERAGE needs a clang compiler")
endif()
option(DAGOR_BUILD_STAMP "Stamp programs with the configure date and time (CI); off, they say '*' and never relink for it" OFF)

# --- features --------------------------------------------------------------------------------------------------------
# the Linux GUI layer of programs with a GUI (engine/osApiWrappers/linuxGUI)
option(DAGOR_LINUX_X11 "X11 support of Linux GUI programs" ON)
option(DAGOR_LINUX_WAYLAND "Wayland support of Linux GUI programs" ON)

# daScript ahead-of-time compilation of the game's scripts (to C++, or with LLVM to objects)
option(DAGOR_DAS_AOT "Compile the daScript game scripts ahead of time" OFF)
if(DAGOR_DAS_AOT AND DAGOR_DAS_AOT_COMPILER)
  message(FATAL_ERROR "The AOT compiler's tree (DAGOR_DAS_AOT_COMPILER) has no DAGOR_DAS_AOT")
endif()
option(DAGOR_DAS_LLVM_AOT "daScript AOT through LLVM objects instead of C++" OFF)
set(_sq_var_trace OFF)
if(DAGOR_VARIANT STREQUAL "dargbox")
  set(_sq_var_trace ON)
endif()
option(DAGOR_SQ_VAR_TRACE "Quirrel variable tracing (dargbox's script debugging)" ${_sq_var_trace})

# the 3d drivers of the tree's programs: one is linked directly, several (or one with
# DAGOR_D3D_MULTI_FORCED) through the multi-driver interface (drv3d_pc_multi, _TARGET_D3D_MULTI). A game client has the
# drivers of its platform; the AOT compiler is headless.
set(_d3d_valid_windows null stub vulkan DX11 DX12)
set(_d3d_valid_linux null stub vulkan)
set(_d3d_valid_macOS null stub Metal)
set(_d3d_valid_iOS null stub Metal)
set(_d3d_valid_android null stub vulkan)
set(_d3d_client_windows stub DX11 vulkan DX12)
set(_d3d_client_linux vulkan)
set(_d3d_client_macOS Metal)
set(_d3d_client_iOS Metal)
set(_d3d_client_android vulkan)
# the GUI editors and dargbox render through the platform's drivers and the stub (daEditor3x,
# AssetViewer, impostorBaker, dargbox)
set(_d3d_editor_windows DX11 DX12 vulkan stub)
set(_d3d_editor_linux vulkan stub)
set(_d3d_editor_macOS Metal)
set(_d3d_editor_iOS Metal)
set(_d3d_editor_android vulkan)
set(_d3d stub)
if(DAGOR_DAS_AOT_COMPILER)
  set(_d3d null)
elseif(_client)
  set(_d3d ${_d3d_client_${DAGOR_PLATFORM}})
elseif(DAGOR_VARIANT MATCHES "^(editor|dargbox)$")
  set(_d3d ${_d3d_editor_${DAGOR_PLATFORM}})
endif()
set(DAGOR_D3D_DRIVERS "${_d3d}" CACHE STRING "3d drivers (a list of: ${_d3d_valid_${DAGOR_PLATFORM}})")
foreach(_drv IN LISTS DAGOR_D3D_DRIVERS)
  dagor_check_choice("DAGOR_D3D_DRIVERS for ${DAGOR_PLATFORM}" "${_drv}" ${_d3d_valid_${DAGOR_PLATFORM}})
endforeach()
# games on Windows have the interface whatever their drivers; the render tests use it even with the stub alone
set(_d3d_forced OFF)
if(DAGOR_VARIANT STREQUAL "tests" OR (_game AND WIN32))
  set(_d3d_forced ON)
endif()
option(DAGOR_D3D_MULTI_FORCED "The multi-driver interface even for a single driver" ${_d3d_forced})
list(LENGTH DAGOR_D3D_DRIVERS _d3d_count)
set(DAGOR_D3D_MULTI OFF)
if(_d3d_count GREATER 1 OR DAGOR_D3D_MULTI_FORCED)
  set(DAGOR_D3D_MULTI ON)
endif()

# the shader system (engine/shaders): the editor tools load a second bindump; game clients have their own camera code;
# the shaders' state code can be compiled to C++ (CppStcode) instead of being interpreted
set(_building_tools OFF)
if(DAGOR_VARIANT MATCHES "^(assets|editor)$")
  set(_building_tools ON)
endif()
option(DAGOR_BUILDING_TOOLS "The tree builds the editor tools (a second bindump, ...)" ${_building_tools})
dagor_option(DAGOR_CPP_STCODE both "Shader state code as C++ (both: with the interpreted code as fallback), validate, disable"
  CHOICES both enable validate disable)
option(DAGOR_CPP_STCODE_BRANCHED "C++ state code with dynamic branching" OFF)
option(DAGOR_PROFILE_STCODE "Profile the shader state code" OFF)

# development features in the programs' non-Rel builds
option(DAGOR_NET_IMGUI "netImgui (remote ImGui) in the Dev, IRel and Dbg builds" ON)
option(DAGOR_FORCE_LINK_DEBUG_LINES "Keep the debug line drawing in Rel and IRel" OFF)

# the physics engine (Dagor::Phys, DagorPhys.cmake): Jolt, Bullet for the command-line tools (the GUI editors are on
# Jolt, and link physBullet too)
set(_phys Jolt)
if(_tools AND NOT DAGOR_VARIANT STREQUAL "editor")
  set(_phys Bullet)
endif()
dagor_option(DAGOR_PHYS ${_phys} "Physics engine" CHOICES Jolt Bullet)
option(DAGOR_STREAMLINE "NVIDIA Streamline (DLSS, Reflex) in the drivers (Windows)" OFF)
# crash reports: breakpad's minidumps in the Rel builds of the game clients on Windows and Linux; with
# DAGOR_BREAKPAD_SUBMISSION in every configuration, with its sender (bpreport) next to the game; crashpad's instead
set(_breakpad OFF)
if(_client AND CMAKE_SYSTEM_NAME MATCHES "^(Linux|Windows)$")
  set(_breakpad ON)
endif()
option(DAGOR_BREAKPAD "Crash reports with breakpad (in Rel builds)" ${_breakpad})
option(DAGOR_BREAKPAD_SUBMISSION "Crash reports with breakpad in every configuration, and the game ships bpreport" OFF)
option(DAGOR_CRASHPAD "Crash reports with crashpad instead of breakpad (Windows)" OFF)
if(DAGOR_CRASHPAD AND NOT WIN32)
  message(FATAL_ERROR "DAGOR_CRASHPAD: crashpad is built for Windows only")
endif()
# the configurations that write breakpad's minidumps (the kernel's handler, daNetGame's binder)
set(DAGOR_BREAKPAD_CONFIGS "$<BOOL:0>")
if(DAGOR_BREAKPAD_SUBMISSION AND NOT DAGOR_CRASHPAD)
  set(DAGOR_BREAKPAD_CONFIGS "$<BOOL:1>")
elseif(DAGOR_BREAKPAD AND NOT DAGOR_CRASHPAD)
  set(DAGOR_BREAKPAD_CONFIGS "$<CONFIG:Rel>")
endif()
set(_time_profiler ON)
if(_linux_server)
  set(_time_profiler OFF)
endif()
option(DAGOR_TIME_PROFILER "The time profiler (DA_PROFILE); the Linux dedicated servers go without" ${_time_profiler})
option(DAGOR_SYNC_ASYNC_READ "Serve the dfa_* async file API with blocking reads instead of AIO (posix)" ${_linux_server})

foreach(_var game client tools linux_server sse fp march kernel strict_aliasing exceptions checked stack_protection rtti
             force_logs sq_var_trace d3d d3d_forced d3d_count drv building_tools cam_stub phys time_profiler)
  unset(_${_var})
endforeach()
foreach(_platform windows linux macOS iOS android)
  unset(_d3d_valid_${_platform})
  unset(_d3d_client_${_platform})
endforeach()
unset(_var)
unset(_platform)
