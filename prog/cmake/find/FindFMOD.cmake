# The FMOD Studio API ("FMOD Engine" at fmod.com) of the games' sound (DAGOR_GAME_SOUND).
#   FMOD::Core, FMOD::Studio  the headers and libraries of the low-level and Studio APIs, the logging builds (fmodL) in
#                             every configuration but Rel; the programs that link them get their shared libraries next
#                             to them
#   FMOD_VERSION              the API's version (fmod_common.h), e.g. 2.04.00
# FMOD_ROOT: the API's dir (the one with api/core and api/studio), by default where its installer puts it: on Windows
# "<Program Files (x86)>/FMOD SoundSystem/FMOD Studio API Windows", on Linux the newest ~/fmodstudioapi*linux, on macOS
# "~/FMOD Programmers API". It is proprietary: never fetched.
if(NOT FMOD_ROOT)
  set(_fmod_root)
  if(CMAKE_HOST_WIN32)
    set(_pf86 "ProgramFiles(x86)")
    set(_fmod_root "$ENV{${_pf86}}/FMOD SoundSystem/FMOD Studio API Windows")
  elseif(CMAKE_HOST_APPLE)
    set(_fmod_root "$ENV{HOME}/FMOD Programmers API")
  elseif(CMAKE_HOST_UNIX)
    file(GLOB _fmod_roots LIST_DIRECTORIES true "$ENV{HOME}/fmodstudioapi*linux")
    list(SORT _fmod_roots COMPARE NATURAL ORDER DESCENDING)
    list(POP_FRONT _fmod_roots _fmod_root)
  endif()
  file(TO_CMAKE_PATH "${_fmod_root}" _fmod_root)
  set(FMOD_ROOT "${_fmod_root}" CACHE PATH "The FMOD Studio API (the dir with api/core and api/studio)")
endif()

find_path(FMOD_CORE_INCLUDE_DIR fmod.h PATHS "${FMOD_ROOT}/api/core/inc" NO_DEFAULT_PATH)
find_path(FMOD_STUDIO_INCLUDE_DIR fmod_studio.h PATHS "${FMOD_ROOT}/api/studio/inc" NO_DEFAULT_PATH)
if(FMOD_CORE_INCLUDE_DIR AND EXISTS "${FMOD_CORE_INCLUDE_DIR}/fmod_common.h")
  file(STRINGS "${FMOD_CORE_INCLUDE_DIR}/fmod_common.h" _fmod_version REGEX "#define[ \t]+FMOD_VERSION[ \t]+0x")
  if(_fmod_version MATCHES "0x0*([0-9a-fA-F]+)([0-9a-fA-F][0-9a-fA-F])([0-9a-fA-F][0-9a-fA-F])")
    set(FMOD_VERSION "${CMAKE_MATCH_1}.${CMAKE_MATCH_2}.${CMAKE_MATCH_3}")
  endif()
endif()

# the libraries of each API: <api>_LIBRARY and <api>L_LIBRARY (the logging build) to link, <api>_RUNTIME and
# <api>L_RUNTIME the shared libraries to put next to the program (none where they link statically)
set(_fmod_arch ${DAGOR_ARCH})
if(WIN32)
  if(DAGOR_ARCH STREQUAL "x86_64")
    set(_fmod_arch x64)
  endif()
  set(_fmod_link "<name>_vc.lib")
  set(_fmod_runtime "<name>.dll")
elseif(ANDROID)
  set(_fmod_arch arm64-v8a)
  set(_fmod_link "lib<name>.so")
  set(_fmod_runtime "lib<name>.so")
elseif(IOS)
  set(_fmod_arch "")
  set(_fmod_link "lib<name>_iphoneos.a")
  set(_fmod_runtime "")
elseif(APPLE)
  set(_fmod_arch "")
  set(_fmod_link "lib<name>.dylib")
  set(_fmod_runtime "lib<name>.dylib")
else()
  set(_fmod_link "lib<name>.so")
  set(_fmod_runtime "lib<name>.so.<soname>")
endif()
set(_fmod_vars)
foreach(_api core studio)
  set(_dir "${FMOD_ROOT}/api/${_api}/lib/${_fmod_arch}")
  set(_base fmod)
  if(_api STREQUAL "studio")
    set(_base fmodstudio)
  endif()
  string(TOUPPER "${_api}" _API)
  foreach(_build "" L)
    string(REPLACE "<name>" "${_base}${_build}" _file "${_fmod_link}")
    find_file(FMOD_${_API}${_build}_LIBRARY "${_file}" PATHS "${_dir}" NO_DEFAULT_PATH)
    list(APPEND _fmod_vars FMOD_${_API}${_build}_LIBRARY)
    set(FMOD_${_API}${_build}_RUNTIME)
    if(_fmod_runtime MATCHES "<soname>")
      # Linux: the file named after the library's soname (lib<name>.so.<major>), the one the program asks for
      file(GLOB _sonames "${_dir}/lib${_base}${_build}.so.*")
      list(FILTER _sonames INCLUDE REGEX "\\.so\\.[0-9]+$")
      list(GET _sonames 0 FMOD_${_API}${_build}_RUNTIME)
    elseif(_fmod_runtime)
      string(REPLACE "<name>" "${_base}${_build}" _file "${_fmod_runtime}")
      set(FMOD_${_API}${_build}_RUNTIME "${_dir}/${_file}")
    endif()
  endforeach()
endforeach()

include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(FMOD REQUIRED_VARS FMOD_CORE_INCLUDE_DIR FMOD_STUDIO_INCLUDE_DIR ${_fmod_vars}
  VERSION_VAR FMOD_VERSION)
if(FMOD_FOUND AND NOT TARGET FMOD::Core)
  set(_rel "$<CONFIG:Rel>")
  foreach(_api Core Studio)
    string(TOUPPER "${_api}" _API)
    add_library(FMOD::${_api} INTERFACE IMPORTED GLOBAL)
    set_target_properties(FMOD::${_api} PROPERTIES
      INTERFACE_INCLUDE_DIRECTORIES "${FMOD_${_API}_INCLUDE_DIR}"
      INTERFACE_LINK_LIBRARIES "$<IF:${_rel},${FMOD_${_API}_LIBRARY},${FMOD_${_API}L_LIBRARY}>")
    if(FMOD_${_API}_RUNTIME)
      set_target_properties(FMOD::${_api} PROPERTIES TRANSITIVE_LINK_PROPERTIES DAGOR_RUNTIME_FILES
        INTERFACE_DAGOR_RUNTIME_FILES ".|$<IF:${_rel},${FMOD_${_API}_RUNTIME},${FMOD_${_API}L_RUNTIME}>")
    endif()
  endforeach()
  set_property(TARGET FMOD::Studio APPEND PROPERTY INTERFACE_LINK_LIBRARIES FMOD::Core)
  set_property(TARGET FMOD::Core APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS FMOD_SRC_VERSION=0)
endif()
unset(_pf86)
unset(_fmod_root)
unset(_fmod_roots)
unset(_fmod_version)
unset(_fmod_arch)
unset(_fmod_link)
unset(_fmod_runtime)
unset(_fmod_vars)
unset(_sonames)
unset(_rel)
