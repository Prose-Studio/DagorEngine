# The Autodesk 3ds Max SDKs of the 3ds Max plugin (the maxplug tree), of the versions DAGOR_MAX_VERSIONS (2025 and
# later, whose toolset is VS 2022's):
#   MaxSDK::<version>  its headers and the libraries of the plugin (maxutil, core, bmm, mesh, geom, flt, MNMath, maxscrpt)
#   MaxSDK_VERSIONS    the versions found
# MaxSDK_<version>_ROOT: the SDK's dir (<install>/maxsdk), by default the one the SDK's installer names
# (ADSK_3DSMAX_SDK_<version>) or its default install dir. It is proprietary: never fetched.
set(DAGOR_MAX_VERSIONS 2025 2026 2027 CACHE STRING "The 3ds Max versions of the plugin (2025 and later)")
set(MaxSDK_VERSIONS)
foreach(_version IN LISTS DAGOR_MAX_VERSIONS)
  if(_version LESS 2025)
    message(FATAL_ERROR "DAGOR_MAX_VERSIONS: 3ds Max ${_version} is not supported (2025 and later are)")
  endif()
  set(_root "$ENV{ADSK_3DSMAX_SDK_${_version}}")
  if(NOT _root)
    set(_root "$ENV{ProgramFiles}/Autodesk/3ds Max ${_version} SDK/maxsdk")
  endif()
  set(MaxSDK_${_version}_ROOT "${_root}" CACHE PATH "The 3ds Max ${_version} SDK (<install>/maxsdk)")
  find_path(MaxSDK_${_version}_INCLUDE_DIR max.h PATHS "${MaxSDK_${_version}_ROOT}/include" NO_DEFAULT_PATH)
  set(_found ${MaxSDK_${_version}_INCLUDE_DIR})
  set(_libraries)
  foreach(_lib maxutil core bmm mesh geom flt MNMath maxscrpt)
    find_library(MaxSDK_${_version}_${_lib}_LIBRARY ${_lib} PATHS "${MaxSDK_${_version}_ROOT}/lib/x64/Release"
      NO_DEFAULT_PATH)
    if(NOT MaxSDK_${_version}_${_lib}_LIBRARY)
      set(_found)
    endif()
    list(APPEND _libraries "${MaxSDK_${_version}_${_lib}_LIBRARY}")
  endforeach()
  if(_found)
    list(APPEND MaxSDK_VERSIONS ${_version})
    if(NOT TARGET MaxSDK::${_version})
      add_library(MaxSDK::${_version} INTERFACE IMPORTED GLOBAL)
      set_target_properties(MaxSDK::${_version} PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${MaxSDK_${_version}_INCLUDE_DIR}"
        INTERFACE_LINK_LIBRARIES "${_libraries}")
    endif()
  endif()
endforeach()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(MaxSDK REQUIRED_VARS MaxSDK_VERSIONS)
unset(_version)
unset(_root)
unset(_found)
unset(_libraries)
