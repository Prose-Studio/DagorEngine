# The Autodesk 3ds Max SDK of DAGOR_MAX_VERSION (Max2023 ... Max2027) for the 3ds Max plugins (the maxplug tree).
#   MaxSDK::MaxSDK  its headers and the libraries of the plugins (maxutil, core, bmm, mesh, geom, flt, MNMath, maxscrpt)
# MaxSDK_ROOT: the SDK's dir (<install>/maxsdk). It is proprietary: never fetched.
set(DAGOR_MAX_VERSION Max2027 CACHE STRING "The 3ds Max version of the plugins")
set_property(CACHE DAGOR_MAX_VERSION PROPERTY STRINGS Max2023 Max2024 Max2025 Max2026 Max2027)
set(MaxSDK_ROOT "$ENV{MaxSDK_ROOT}" CACHE PATH "The 3ds Max SDK (<install>/maxsdk) of DAGOR_MAX_VERSION")
find_path(MaxSDK_INCLUDE_DIR max.h PATHS "${MaxSDK_ROOT}/include" NO_DEFAULT_PATH)
set(_maxsdk_libs maxutil core bmm mesh geom flt MNMath maxscrpt)
set(_maxsdk_vars)
foreach(_lib IN LISTS _maxsdk_libs)
  find_library(MaxSDK_${_lib}_LIBRARY ${_lib} PATHS "${MaxSDK_ROOT}/lib/x64/Release" NO_DEFAULT_PATH)
  list(APPEND _maxsdk_vars MaxSDK_${_lib}_LIBRARY)
endforeach()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(MaxSDK REQUIRED_VARS MaxSDK_INCLUDE_DIR ${_maxsdk_vars})
if(MaxSDK_FOUND AND NOT TARGET MaxSDK::MaxSDK)
  add_library(MaxSDK::MaxSDK INTERFACE IMPORTED GLOBAL)
  set(_maxsdk_files)
  foreach(_var IN LISTS _maxsdk_vars)
    list(APPEND _maxsdk_files "${${_var}}")
  endforeach()
  set_target_properties(MaxSDK::MaxSDK PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${MaxSDK_INCLUDE_DIR}"
    INTERFACE_LINK_LIBRARIES "${_maxsdk_files}")
endif()
unset(_maxsdk_libs)
unset(_maxsdk_vars)
unset(_maxsdk_files)
