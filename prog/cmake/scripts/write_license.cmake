# cmake -DLIST=<file> -DPROGRAM=<file name> -DOUT=<LICENSE file> -P write_license.cmake
# Writes the LICENSE file of a program or shared library: the license texts of the libraries it links (LIST, one file
# per line: its DAGOR_LICENSE_FILES), each headed by its directory's name. Unchanged, the file is
# left alone.
file(STRINGS "${LIST}" files)
set(body "")
foreach(file IN LISTS files)
  if(NOT file)
    continue()
  endif()
  cmake_path(GET file PARENT_PATH lib_dir)
  cmake_path(GET lib_dir FILENAME lib_name)
  file(READ "${file}" bom LIMIT 3 HEX)
  if(bom STREQUAL "efbbbf") # the UTF-8 byte order mark is dropped
    file(READ "${file}" text OFFSET 3)
  else()
    file(READ "${file}" text)
  endif()
  string(APPEND body "\n==== ${lib_name}\n\n${text}")
endforeach()
if(body STREQUAL "")
  file(REMOVE "${OUT}")
  return()
endif()
set(content "${PROGRAM} uses libraries:\n${body}")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL content)
    return()
  endif()
endif()
cmake_path(GET OUT PARENT_PATH out_dir)
file(MAKE_DIRECTORY "${out_dir}")
file(WRITE "${OUT}" "${content}")
