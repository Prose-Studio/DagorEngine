# cmake -DCODE=<exit code | crash> [-DFILES=<file>;...] -P expect_exit.cmake <command>...
# Runs the command and fails unless it ends that way (crash: killed by a signal or an exception, no exit code) and the
# files exist afterwards: the CTest checks of programs that must fail in a given way.
set(command)
set(i 1)
while(i LESS CMAKE_ARGC)
  if(CMAKE_ARGV${i} STREQUAL "-P")
    math(EXPR i "${i} + 2") # the script's own path
    break()
  endif()
  math(EXPR i "${i} + 1")
endwhile()
while(i LESS CMAKE_ARGC)
  list(APPEND command "${CMAKE_ARGV${i}}")
  math(EXPR i "${i} + 1")
endwhile()
if(NOT command OR NOT DEFINED CODE)
  message(FATAL_ERROR "usage: cmake -DCODE=<exit code | crash> [-DFILES=<file>;...] -P expect_exit.cmake <command>...")
endif()
file(REMOVE ${FILES}) # (a previous run's)
execute_process(COMMAND ${command} RESULT_VARIABLE result)
if(CODE STREQUAL "crash")
  if(result MATCHES "^[0-9]+$")
    message(FATAL_ERROR "expected a crash, the program exited with ${result}")
  endif()
elseif(NOT result STREQUAL CODE)
  message(FATAL_ERROR "expected exit code ${CODE}, got ${result}")
endif()
foreach(file IN LISTS FILES)
  if(NOT EXISTS "${file}")
    message(FATAL_ERROR "${file} was not written")
  endif()
endforeach()
