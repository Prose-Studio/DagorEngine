# macOS: the target definitions and link settings (included by DagorCompilerFlags.cmake, whose helpers and conditions
# it uses). A universal binary compiles each file for both archs, so the arch settings go to one -arch each.
include("${CMAKE_CURRENT_LIST_DIR}/Apple.cmake")
dagor_compile_definitions(1 _TARGET_PC=2 _TARGET_PC_MACOSX=2 _TARGET_APPLE=1 __MACOSX__)
set(_x64 -D_TARGET_ARCH_X86_64 -D_TARGET_SIMD_SSE=${DAGOR_SSE} -msse4.1)
set(_a64 -D_TARGET_ARCH_ARM64 -D_TARGET_SIMD_NEON -DARM_NEON_GCC_COMPATIBILITY)
if(DAGOR_ARCH STREQUAL "universal")
  list(TRANSFORM _x64 PREPEND "SHELL:-Xarch_x86_64 ")
  list(TRANSFORM _a64 PREPEND "SHELL:-Xarch_arm64 ")
  dagor_compile_options("${_c_cxx}" ${_x64} ${_a64})
elseif(DAGOR_ARCH STREQUAL "x86_64")
  dagor_compile_options("${_c_cxx}" ${_x64})
else()
  dagor_compile_options("${_c_cxx}" ${_a64})
endif()
unset(_x64)
unset(_a64)
foreach(_framework Foundation QuartzCore CoreLocation Cocoa IOKit CoreFoundation Security Carbon SystemConfiguration Metal)
  link_libraries("$<${_linked}:System::${_framework}>")
endforeach()
unset(_framework)
