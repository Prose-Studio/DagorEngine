# Linux with clang: the pinned LLVM (fetched into the deps cache, or DAGOR_LLVM_DIR), against the system's libstdc++
# and glibc; -DDAGOR_CLANG_VERSION=<N> uses the distro's clang-<N> instead (DAGOR_CLANG_VERSION=system: plain clang).
include("${CMAKE_CURRENT_LIST_DIR}/_common.cmake")
dagor_toolchain_forward(DAGOR_CLANG_VERSION DAGOR_LLVM_DIR)

if(DAGOR_CLANG_VERSION)
  set(_dagor_suffix "-${DAGOR_CLANG_VERSION}")
  if(DAGOR_CLANG_VERSION STREQUAL "system")
    set(_dagor_suffix "")
  endif()
  find_program(CMAKE_C_COMPILER NAMES clang${_dagor_suffix} REQUIRED)
  find_program(CMAKE_CXX_COMPILER NAMES clang++${_dagor_suffix} REQUIRED)
  find_program(CMAKE_AR NAMES llvm-ar${_dagor_suffix} llvm-ar ar)
  find_program(CMAKE_RANLIB NAMES llvm-ranlib${_dagor_suffix} llvm-ranlib ranlib)
  unset(_dagor_suffix)
else()
  dagor_toolchain_llvm()
  set(CMAKE_C_COMPILER "${DAGOR_LLVM_DIR}/bin/clang")
  set(CMAKE_CXX_COMPILER "${DAGOR_LLVM_DIR}/bin/clang++")
  set(CMAKE_AR "${DAGOR_LLVM_DIR}/bin/llvm-ar")
  set(CMAKE_RANLIB "${DAGOR_LLVM_DIR}/bin/llvm-ranlib")
  set(CMAKE_LINKER_TYPE LLD)
endif()
if(DAGOR_ARCH STREQUAL "arm64" AND NOT DAGOR_HOST_ARCH STREQUAL "arm64")
  set(CMAKE_SYSTEM_NAME Linux)
  set(CMAKE_SYSTEM_PROCESSOR aarch64)
  set(CMAKE_C_COMPILER_TARGET aarch64-linux-gnu)
  set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-gnu)
endif()
