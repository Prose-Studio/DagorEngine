# Android (arm64-v8a) with the NDK's own toolchain file. The NDK is found on the machine: DAGOR_ANDROID_NDK, or
# ANDROID_NDK_HOME / ANDROID_NDK_ROOT, or the newest ndk/<version> of the Android SDK (ANDROID_HOME, ANDROID_SDK_ROOT).
# DAGOR_ANDROID_API is the minimum API level.
include("${CMAKE_CURRENT_LIST_DIR}/_common.cmake")
dagor_toolchain_forward(DAGOR_ANDROID_NDK DAGOR_ANDROID_API)

if(NOT DAGOR_ANDROID_NDK)
  foreach(_dagor_var ANDROID_NDK_HOME ANDROID_NDK_ROOT)
    if(DEFINED ENV{${_dagor_var}} AND IS_DIRECTORY "$ENV{${_dagor_var}}")
      set(_dagor_ndk "$ENV{${_dagor_var}}")
      break()
    endif()
  endforeach()
  if(NOT _dagor_ndk)
    foreach(_dagor_var ANDROID_HOME ANDROID_SDK_ROOT)
      if(DEFINED ENV{${_dagor_var}})
        file(GLOB _dagor_ndks LIST_DIRECTORIES true "$ENV{${_dagor_var}}/ndk/*")
        list(SORT _dagor_ndks COMPARE NATURAL ORDER DESCENDING)
        if(_dagor_ndks)
          list(GET _dagor_ndks 0 _dagor_ndk)
          break()
        endif()
      endif()
    endforeach()
  endif()
  if(NOT _dagor_ndk)
    message(FATAL_ERROR "The Android NDK was not found: install it with the Android SDK manager (sdkmanager \"ndk;<version>\") "
                        "and set ANDROID_NDK_HOME, or pass -DDAGOR_ANDROID_NDK=<dir>")
  endif()
  file(TO_CMAKE_PATH "${_dagor_ndk}" _dagor_ndk)
  set(DAGOR_ANDROID_NDK "${_dagor_ndk}" CACHE PATH "Android NDK")
endif()
if(NOT DAGOR_ANDROID_API)
  set(DAGOR_ANDROID_API 28)
endif()
set(DAGOR_ARCH arm64 CACHE STRING "Target architecture" FORCE)
set(ANDROID_ABI arm64-v8a)
set(ANDROID_PLATFORM android-${DAGOR_ANDROID_API})
set(ANDROID_STL c++_static)
include("${DAGOR_ANDROID_NDK}/build/cmake/android.toolchain.cmake")
unset(_dagor_var)
unset(_dagor_ndk)
unset(_dagor_ndks)
