# Sources generated at build time, added to a target:
#
#   dagor_target_es_sources(<target> <file>...)
#       the entity systems of <file>ES.cpp.inl (or of a .cpp that the generated file includes; it is not compiled
#       itself then): their registration code, made by prog/cmake/scripts/codegen/gen_es.py (libclang) from each file
#       with the target's own definitions and include dirs. $<cond:path> for those of some configurations.
#   dagor_target_stringify(<target> [ARRAY] <file>...)
#       <file>.inl with the file's text as a C string literal (ARRAY: a byte array), for embedding scripts such as
#       daScript modules (#include "<file>.inl" from the dir of the including source)
#   dagor_legacy_parsers(<target> [LEX <file>.dlp...] [SYN <file>.whl...])
#       the shader compilers' lexers (dolphin: <file>.cpp, <file>.h) and LR parsers (whale: <file>.cpp, <file>.h,
#       <file>tok.h), generated by dolphin and whale (prog/3rdPartyLibs/legacy_parser; the host's when cross-compiling)
include_guard(GLOBAL)

set(DAGOR_CODEGEN_DIR "${CMAKE_CURRENT_LIST_DIR}/scripts/codegen")

# _dagor_config_source(<source> <cond-var> <path-var>): the condition and the absolute path of $<cond:path>; both empty
# for a plain source
function(_dagor_config_source source cond_var path_var)
  set(path)
  set(cond)
  if(source MATCHES "^\\$<" AND NOT source MATCHES "^\\$<IF:")
    if(source MATCHES ":([A-Za-z]:/[^:<>]*)>$") # a Windows drive letter's colon is part of the path
      set(path "${CMAKE_MATCH_1}")
    elseif(source MATCHES ":([^:<>]+)>$")
      set(path "${CMAKE_MATCH_1}")
    endif()
  endif()
  if(path)
    string(LENGTH "${source}" n)
    string(LENGTH "${path}" path_n)
    math(EXPR cond_n "${n} - ${path_n} - 4")
    string(SUBSTRING "${source}" 2 ${cond_n} cond)
    cmake_path(ABSOLUTE_PATH path NORMALIZE)
  endif()
  set(${cond_var} "${cond}" PARENT_SCOPE)
  set(${path_var} "${path}" PARENT_SCOPE)
endfunction()

function(dagor_target_stringify target)
  cmake_parse_arguments(PARSE_ARGV 1 arg "ARRAY" "" "")
  set(mode "")
  if(arg_ARRAY)
    set(mode --array)
  endif()
  set(gen_dir "${CMAKE_CURRENT_BINARY_DIR}/gen/${target}")
  set(outputs)
  set(dirs)
  foreach(file IN LISTS arg_UNPARSED_ARGUMENTS)
    cmake_path(ABSOLUTE_PATH file NORMALIZE OUTPUT_VARIABLE src)
    cmake_path(RELATIVE_PATH src BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" OUTPUT_VARIABLE rel)
    # a file outside the calling dir stays in the gen dir: ../ would not resolve on POSIX until the dirs exist
    string(REPLACE "../" "__/" rel "${rel}")
    set(out "${gen_dir}/${rel}.inl")
    add_custom_command(OUTPUT "${out}"
      COMMAND "${Python3_EXECUTABLE}" "${DAGOR_CODEGEN_DIR}/stringify.py" ${mode} "${src}" "${out}"
      DEPENDS "${src}" "${DAGOR_CODEGEN_DIR}/stringify.py"
      COMMENT "Stringifying ${rel}"
      VERBATIM)
    list(APPEND outputs "${out}")
    cmake_path(GET out PARENT_PATH out_dir) # the sources include it by its name, as from their own dir
    list(APPEND dirs "${out_dir}")
  endforeach()
  list(REMOVE_DUPLICATES dirs)
  target_sources(${target} PRIVATE ${outputs})
  target_include_directories(${target} PRIVATE "${gen_dir}" ${dirs})
endfunction()

function(dagor_legacy_parsers target)
  cmake_parse_arguments(PARSE_ARGV 1 arg "" "" "LEX;SYN")
  set(gen_dir "${CMAKE_CURRENT_BINARY_DIR}/gen/${target}/parsers")
  set(sources)
  foreach(kind LEX SYN)
    foreach(file IN LISTS arg_${kind})
      cmake_path(ABSOLUTE_PATH file NORMALIZE OUTPUT_VARIABLE src)
      cmake_path(GET src STEM stem)
      cmake_path(GET src FILENAME name)
      if(kind STREQUAL "LEX")
        set(tool dolphin)
        set(suffixes .cpp .h)
      else()
        set(tool whale)
        set(suffixes .cpp .h tok.h)
      endif()
      dagor_host_tool(${tool} tool_path)
      set(outputs)
      foreach(suffix IN LISTS suffixes)
        list(APPEND outputs "${gen_dir}/${stem}${suffix}")
      endforeach()
      add_custom_command(OUTPUT ${outputs}
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${src}" "${gen_dir}/${name}"
        COMMAND "${tool_path}" "${name}"
        WORKING_DIRECTORY "${gen_dir}"
        DEPENDS "${src}" ${tool_path_DEPENDS}
        COMMENT "Generating ${name} (${tool})"
        VERBATIM)
      list(APPEND sources ${outputs})
    endforeach()
  endforeach()
  file(MAKE_DIRECTORY "${gen_dir}")
  target_sources(${target} PRIVATE ${sources})
  target_include_directories(${target} PRIVATE "${gen_dir}")
endfunction()

# the arguments the ES codegen parses a target's sources with, per configuration: its definitions and include dirs, the
# forced includes and the system headers, which the toolchain gives the compiler by other means (on Windows clang's own,
# MSVC's and the SDK's, on Apple platforms the SDK's; elsewhere libclang finds the system's as usual)
function(_dagor_es_args target out)
  set(gen_dir "${CMAKE_CURRENT_BINARY_DIR}/gen/${target}/es")
  set(defines "$<TARGET_PROPERTY:${target},COMPILE_DEFINITIONS>")
  set(includes "$<TARGET_PROPERTY:${target},INCLUDE_DIRECTORIES>")
  set(content "$<$<BOOL:${defines}>:-D$<JOIN:${defines},\n-D>\n>$<$<BOOL:${includes}>:-I$<JOIN:${includes},\n-I>\n>")
  foreach(header IN LISTS DAGOR_FORCED_INCLUDES)
    string(APPEND content "-include\n${header}\n")
  endforeach()
  if(WIN32)
    file(GLOB clang_builtins LIST_DIRECTORIES true "${DAGOR_ES_LLVM_DIR}/lib/clang/*/include")
    set(sdk_inc "${DAGOR_WINSDK_DIR}/Include/${DAGOR_WINSDK_RESOLVED_VERSION}")
    foreach(dir IN ITEMS ${clang_builtins} "${DAGOR_MSVC_DIR}/include" "${sdk_inc}/ucrt" "${sdk_inc}/um" "${sdk_inc}/shared")
      string(APPEND content "-imsvc\n${dir}\n")
    endforeach()
  elseif(APPLE)
    # the SDK as Apple's clang searches it: its libc++ (before clang's own headers, not the fetched LLVM's), its system
    # headers (after them) and its frameworks
    set(sdk "${CMAKE_OSX_SYSROOT}")
    if(NOT IS_ABSOLUTE "${sdk}")
      if(NOT sdk)
        set(sdk macosx)
      endif()
      execute_process(COMMAND xcrun --sdk "${sdk}" --show-sdk-path OUTPUT_VARIABLE sdk OUTPUT_STRIP_TRAILING_WHITESPACE
        COMMAND_ERROR_IS_FATAL ANY)
    endif()
    string(APPEND content "-isysroot\n${sdk}\n-isystem\n${sdk}/usr/include/c++/v1\n"
      "-idirafter\n${sdk}/usr/include\n-iframework\n${sdk}/System/Library/Frameworks\n")
  endif()
  file(GENERATE OUTPUT "${gen_dir}/args-$<CONFIG>-$<COMPILE_LANGUAGE>.txt" CONTENT "${content}" TARGET ${target})
  set(${out} "${gen_dir}/args-$<CONFIG>-CXX.txt" PARENT_SCOPE)
endfunction()

function(dagor_target_es_sources target)
  set(files)
  foreach(src IN LISTS ARGN)
    _dagor_config_source("${src}" cond path)
    if(NOT path)
      cmake_path(ABSOLUTE_PATH src NORMALIZE OUTPUT_VARIABLE path)
    endif()
    # a .cpp the generated file includes is not compiled itself
    if(path MATCHES "\\.cpp$")
      set_source_files_properties("${path}" PROPERTIES HEADER_FILE_ONLY ON)
    endif()
    list(APPEND files "${cond}|${path}")
  endforeach()
  # <condition>|<file> of each, for the pull of a game module's or the framework's entity systems (_dagor_es_pulls)
  set_property(TARGET ${target} APPEND PROPERTY DAGOR_ES_FILES ${files})

  dagor_python(python)
  if(NOT DAGOR_ES_LLVM_DIR)
    if(DAGOR_LLVM_DIR)
      set(DAGOR_ES_LLVM_DIR "${DAGOR_LLVM_DIR}" CACHE INTERNAL "")
    else()
      dagor_fetch_sdk(llvm llvm) # libclang, for trees built with GCC or Apple's clang
      set(DAGOR_ES_LLVM_DIR "${llvm}" CACHE INTERNAL "")
    endif()
  endif()
  _dagor_es_args(${target} args)
  set(gen_dir "${CMAKE_CURRENT_BINARY_DIR}/gen/${target}/es")
  set(sources)
  foreach(entry IN LISTS files)
    string(REGEX MATCH "^[^|]*" cond "${entry}")
    string(REGEX REPLACE "^[^|]*\\|" "" src "${entry}")
    cmake_path(GET src FILENAME name)
    string(REGEX REPLACE "\\.[^.]+$" ".gen.es.cpp" out_name "${name}") # <name>ES.cpp.inl, or a .cpp it includes
    # in the subdir the source has in the target's dir: two files of one name (a library's and its stub's) are two outputs
    cmake_path(GET src PARENT_PATH src_dir)
    cmake_path(RELATIVE_PATH src_dir BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" OUTPUT_VARIABLE sub)
    set(out_dir "${gen_dir}")
    if(NOT (sub STREQUAL "" OR sub STREQUAL "." OR sub MATCHES "^\\.\\." OR IS_ABSOLUTE "${sub}"))
      string(APPEND out_dir "/${sub}")
    endif()
    set(out "${out_dir}/${out_name}")
    # the generated file includes the source by its name: through a file next to it
    file(CONFIGURE OUTPUT "${out_dir}/${name}" CONTENT "#include \"${src}\"\n")
    # the descriptors record the source relative to the engine root (absolute on another drive)
    cmake_path(RELATIVE_PATH src BASE_DIRECTORY "${DAGOR_ENGINE_ROOT}" OUTPUT_VARIABLE input)
    if(IS_ABSOLUTE "${input}")
      set(input "${src}")
    endif()
    add_custom_command(OUTPUT "${out}"
      COMMAND "${CMAKE_COMMAND}" -E env "DAGOR_CLANG_DIR=${DAGOR_ES_LLVM_DIR}"
        "${python}" "${DAGOR_CODEGEN_DIR}/gen_es.py" "${input}" "${out}" "${name}" "@${args}"
      # gen_es.py leaves an unchanged output as it was: newer than its inputs now, it is not made again
      COMMAND "${CMAKE_COMMAND}" -E touch_nocreate "${out}"
      DEPENDS "${src}" "${args}" "${DAGOR_CODEGEN_DIR}/gen_es.py" "${DAGOR_CODEGEN_DIR}/gen_es30.py"
        "${DAGOR_CODEGEN_DIR}/clang_ecs_parser.py"
      WORKING_DIRECTORY "${DAGOR_ENGINE_ROOT}"
      COMMENT "ES codegen: ${name}"
      VERBATIM)
    if(cond)
      set(out "$<${cond}:${out}>")
    endif()
    list(APPEND sources "${out}")
  endforeach()
  target_sources(${target} PRIVATE ${sources})
endfunction()
