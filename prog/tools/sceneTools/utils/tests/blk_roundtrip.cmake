# cmake -DBINBLK=<binBlk> -DMODE=<binary|packed|bbf3|robin> [-DBLK2ROBIN=<blk2robin>] -P blk_roundtrip.cmake
#       <text BLK>... (in DAGOR_TEST_OUT)
# Converts each text BLK to a binary form and back and fails unless the text read back is the BLK's own canonical text
# (binBlk -t): binary and packed are binBlk's current formats (which must also keep every bit, so binary -> binary is
# the same file and packed -> binary gives it back), bbf3 its legacy one, robin blk2robin's read-only binary BLK read
# back by RoDataBlock. Text BLK keeps reals to 6 digits (%g), so only the binary comparisons see full precision.
include("${CMAKE_CURRENT_LIST_DIR}/blk_check.cmake")
set(inputs)
set(i 1)
while(i LESS CMAKE_ARGC)
  if(CMAKE_ARGV${i} STREQUAL "-P")
    math(EXPR i "${i} + 2") # the script's own path
    break()
  endif()
  math(EXPR i "${i} + 1")
endwhile()
while(i LESS CMAKE_ARGC)
  list(APPEND inputs "${CMAKE_ARGV${i}}")
  math(EXPR i "${i} + 1")
endwhile()
if(NOT inputs OR NOT BINBLK OR NOT MODE MATCHES "^(binary|packed|bbf3|robin)$"
   OR (MODE STREQUAL "robin" AND NOT BLK2ROBIN))
  message(FATAL_ERROR "usage: cmake -DBINBLK=<binBlk> -DMODE=<binary|packed|bbf3|robin> [-DBLK2ROBIN=<blk2robin>] "
    "-P blk_roundtrip.cmake <text BLK>...")
endif()
blk_test_out()

foreach(input IN LISTS inputs)
  cmake_path(GET input FILENAME name)
  set(base "${OUT}/${name}")
  run("${BINBLK}" "${input}" "${base}.canon.blk" -t -h)
  if(MODE STREQUAL "robin")
    run("${BLK2ROBIN}" "${input}" "${base}.roblk" "${base}.back.blk")
  else()
    run("${BINBLK}" "${input}" "${base}.bin" -b -h)
    check_header("${base}.bin" "01" "a binary BLK")
    if(MODE STREQUAL "binary")
      run("${BINBLK}" "${base}.bin" "${base}.back.blk" -t -h)
      run("${BINBLK}" "${base}.bin" "${base}.again.bin" -b -h)
      check_same_binary("${base}.bin" "${base}.again.bin" "the binary BLK read and written again changed")
    elseif(MODE STREQUAL "packed")
      run("${BINBLK}" "${base}.bin" "${base}.packed.bin" -z -h)
      check_header("${base}.packed.bin" "02" "a packed binary BLK")
      run("${BINBLK}" "${base}.packed.bin" "${base}.back.blk" -t -h)
      run("${BINBLK}" "${base}.packed.bin" "${base}.unpacked.bin" -b -h)
      check_same_binary("${base}.bin" "${base}.unpacked.bin" "the packed BLK does not give the binary one back")
    else()
      run("${BINBLK}" "${base}.bin" "${base}.bbf3.bin" -b -bbf3 -h)
      check_header("${base}.bbf3.bin" "00424246" "a BBF3 binary BLK")
      run("${BINBLK}" "${base}.bbf3.bin" "${base}.back.blk" -t -h)
    endif()
  endif()
  check_same_text("${base}.canon.blk" "${base}.back.blk")
endforeach()
