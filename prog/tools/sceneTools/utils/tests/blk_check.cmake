# The checks of the BLK tools' test scripts (included by them): commands run in ${OUT} and fail the script unless
# they succeed, files compared byte for byte or text line by line.

# OUT: the test's dir (DAGOR_TEST_OUT, which CTest sets: <build>/test-artifacts/<test>, kept for a failure), emptied
macro(blk_test_out)
  set(OUT "$ENV{DAGOR_TEST_OUT}")
  if(NOT OUT)
    message(FATAL_ERROR "DAGOR_TEST_OUT is not set (the tests run through CTest)")
  endif()
  file(REMOVE_RECURSE "${OUT}")
  file(MAKE_DIRECTORY "${OUT}")
endmacro()

# runs the command in ${OUT}; fails unless it exits with 0
function(run)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${OUT}"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE out)
  if(NOT result STREQUAL "0")
    string(REPLACE ";" " " command "${ARGN}")
    message(FATAL_ERROR "${command}\nexited with ${result}:\n${out}")
  endif()
endfunction()

# fails unless <file> starts with the bytes <hex>
function(check_header file hex what)
  string(LENGTH "${hex}" len)
  math(EXPR len "${len} / 2")
  file(READ "${file}" head LIMIT ${len} HEX)
  if(NOT head STREQUAL hex)
    message(FATAL_ERROR "${file} is not ${what}: it starts with ${head}, not ${hex}")
  endif()
endfunction()

function(check_same_binary expected actual what)
  execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files "${expected}" "${actual}" RESULT_VARIABLE different)
  if(different)
    message(FATAL_ERROR "${actual} differs from ${expected}: ${what}")
  endif()
endfunction()

# the line of <text> that starts at <start> (to the next newline)
function(_blk_line_at text start out)
  string(SUBSTRING "${text}" ${start} -1 rest)
  string(FIND "${rest}" "\n" end)
  if(end GREATER_EQUAL 0)
    string(SUBSTRING "${rest}" 0 ${end} rest)
  endif()
  set(${out} "${rest}" PARENT_SCOPE)
endfunction()

# fails unless the two text files are the same, naming the first line that differs (found by a binary search for the
# longest common prefix: the texts are too long to walk line by line in CMake)
function(check_same_text expected actual)
  file(READ "${expected}" a)
  file(READ "${actual}" b)
  if(a STREQUAL b)
    return()
  endif()
  string(LENGTH "${a}" lo)
  string(LENGTH "${b}" hi)
  if(lo LESS hi)
    set(hi ${lo})
  endif()
  set(lo 0)
  while(lo LESS hi)
    math(EXPR mid "(${lo} + ${hi} + 1) / 2")
    string(SUBSTRING "${a}" 0 ${mid} pa)
    string(SUBSTRING "${b}" 0 ${mid} pb)
    if(pa STREQUAL pb)
      set(lo ${mid})
    else()
      math(EXPR hi "${mid} - 1")
    endif()
  endwhile()
  string(SUBSTRING "${a}" 0 ${lo} prefix)
  string(REGEX MATCHALL "\n" newlines "${prefix}")
  list(LENGTH newlines line)
  math(EXPR line "${line} + 1")
  string(FIND "${prefix}" "\n" start REVERSE)
  math(EXPR start "${start} + 1")
  _blk_line_at("${a}" ${start} la)
  _blk_line_at("${b}" ${start} lb)
  message(FATAL_ERROR "${actual} differs from ${expected} at line ${line}:\n  expected: ${la}\n  actual:   ${lb}")
endfunction()
