{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "$comment": [
    "The engine's trees: cmake --list-presets in prog/. <host>[-<compiler>|-<arch>|-<sanitizer>]-<variant>, e.g.",
    "cmake --workflow --preset windows-tests (configure, build, test), cmake --workflow --preset linux-cdk (the tools,",
    "installed into tools/dagor_cdk). The bases are in cmake/presets/base.json; local ones go in CMakeUserPresets.json."
  ],
  "include": [
    "cmake/presets/base.json"
  ],
  "configurePresets": [
    {
      "name": "engine",
      "hidden": true,
      "$comment": "the engine's trees: in build/<preset>, the tools installed into the engine root (tools/dagor_cdk)",
      "environment": {
        "DAGOR_ENGINE_ROOT": "${sourceDir}/.."
      },
      "installDir": "${sourceDir}/.."
    },
    {
      "name": "variant-tests",
      "hidden": true,
      "cacheVariables": {
        "DAGOR_VARIANT": "tests"
      }
    },
