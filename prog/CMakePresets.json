{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "$comment": [
    "The engine's trees: cmake --list-presets in prog/. cmake --workflow --preset <host>[-<compiler>|-<arch>]",
    "(windows, windows-msvc, linux, linux-clang, macos, ...) builds every tree of the host on a fresh clone: the SDKs fetched,",
    "the tools installed into tools/. One tree: <host>[-<compiler>|-<arch>|-<sanitizer>]-<variant>, e.g. cmake --workflow",
    "--preset windows-tests (configure, build, test). The bases are in cmake/presets/base.json; local ones go in",
    "CMakeUserPresets.json."
  ],
  "include": [
    "cmake/presets/base.json"
  ],
  "configurePresets": [
    {
      "name": "engine",
      "hidden": true,
      "$comment": "the engine's trees: in build/<preset>, the tools installed into the engine root (tools/dagor_cdk)",
      "environment": {
        "DAGOR_ENGINE_ROOT": "${sourceDir}/.."
      },
      "installDir": "${sourceDir}/.."
    },
    {
      "name": "windows",
      "inherits": [
        "engine"
      ],
      "$comment": "every tree of the host and toolchain, each built with its preset (cmake --workflow --preset windows)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "DAGOR_ALL_PRESETS": "windows-tests;windows-cdk;windows-assets;windows-editor;windows-dargbox",
        "DAGOR_ALL_INSTALL": "windows-cdk;windows-assets;windows-editor"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/${presetName}"
    },
    {
      "name": "windows-msvc",
      "inherits": [
        "engine"
      ],
      "$comment": "every tree of the host and toolchain, each built with its preset (cmake --workflow --preset windows-msvc)",
