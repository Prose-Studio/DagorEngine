# cmake -DTOOL=<dolphin or whale> -DOUT=<dir> -P generate.cmake <grammar>...
# The test of dolphin and of whale (../../whale): each grammar is generated twice, each run in a dir of its own with the
# tool in the dir of the grammar's copy, as the build generates the shader compilers' parsers (dagor_legacy_parsers).
# Both runs must succeed with the same files, the generated sources among them: the output depends on the grammar alone.
# A grammar with an error (a syntax error for dolphin, an undefined symbol for whale) must fail with its position.
set(grammars)
set(i 1)
while(i LESS CMAKE_ARGC)
  if(CMAKE_ARGV${i} STREQUAL "-P")
    math(EXPR i "${i} + 2") # the script's own path
    break()
  endif()
  math(EXPR i "${i} + 1")
endwhile()
while(i LESS CMAKE_ARGC)
  list(APPEND grammars "${CMAKE_ARGV${i}}")
  math(EXPR i "${i} + 1")
endwhile()
if(NOT TOOL OR NOT OUT OR NOT grammars)
  message(FATAL_ERROR "usage: cmake -DTOOL=<dolphin or whale> -DOUT=<dir> -P generate.cmake <grammar>...")
endif()
file(REMOVE_RECURSE "${OUT}")

# run(<dir> <grammar file name>): the tool on the grammar in <dir>, its exit code and output in result and output
macro(run dir name)
  execute_process(COMMAND "${TOOL}" "${name}" WORKING_DIRECTORY "${dir}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
endmacro()

foreach(grammar IN LISTS grammars)
  cmake_path(GET grammar FILENAME name)
  cmake_path(GET grammar STEM LAST_ONLY stem)
  cmake_path(GET grammar PARENT_PATH grammar_dir)
  cmake_path(GET grammar_dir FILENAME parent)
  set(dir "${OUT}/${parent}.${name}") # (grammars of one name in different dirs)
  foreach(n 1 2)
    file(COPY "${grammar}" DESTINATION "${dir}/run${n}")
    run("${dir}/run${n}" "${name}")
    if(NOT result EQUAL 0 OR NOT EXISTS "${dir}/run${n}/${stem}.cpp" OR NOT EXISTS "${dir}/run${n}/${stem}.h")
      message(FATAL_ERROR "${grammar}: generation ${n} failed (exit code ${result}):\n${output}")
    endif()
    file(GLOB files${n} RELATIVE "${dir}/run${n}" "${dir}/run${n}/*")
  endforeach()
  if(NOT files1 STREQUAL files2)
    message(FATAL_ERROR "${grammar}: the two generations made different files: '${files1}', '${files2}'")
  endif()
  foreach(file IN LISTS files1)
    file(SHA256 "${dir}/run1/${file}" hash1)
    file(SHA256 "${dir}/run2/${file}" hash2)
    if(NOT hash1 STREQUAL hash2)
      message(FATAL_ERROR "${grammar}: the two generations of ${file} differ: ${dir}/run1, ${dir}/run2")
    endif()
  endforeach()
endforeach()

list(GET grammars 0 grammar)
cmake_path(GET grammar EXTENSION LAST_ONLY ext)
if(ext STREQUAL ".dlp")
  set(broken "start_conditions MAIN;\nfoo -> \"a\" |;\n")
  set(error "Syntax error at line 2 column 13")
else()
  set(broken "terminal a;\nS -> a b;\n")
  set(error "Undefined symbol b at line 2 column 8")
endif()
file(WRITE "${OUT}/broken/broken${ext}" "${broken}")
run("${OUT}/broken" "broken${ext}")
if(result EQUAL 0 OR NOT output MATCHES "${error}")
  message(FATAL_ERROR "the broken grammar must fail with '${error}' (exit code ${result}):\n${output}")
endif()
