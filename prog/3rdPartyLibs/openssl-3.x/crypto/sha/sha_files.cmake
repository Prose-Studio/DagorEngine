# SHA with the CPU detection (openssl_collect_c and _asm: openssl.cmake)
set(FILES ${OPENSSL_DIR}/crypto/cryptlib.c ${OPENSSL_DIR}/crypto/cpuid.c ${OPENSSL_DIR}/crypto/ctype.c)
openssl_collect_c(FILES crypto/sha keccak1600.c)
if(OPENSSL_ASM)
  openssl_collect_asm(FILES crypto/sha)
  list(APPEND FILES ${OPENSSL_DIR}/crypto/x86_64cpuid.${OPENSSL_ASM_EXT})
else()
  list(APPEND FILES ${OPENSSL_DIR}/crypto/mem_clr.c ${OPENSSL_DIR}/crypto/sha/keccak1600.c)
endif()
