set(AllSrcFolder_ES )
set(AllSrcFolder_CPP )
if(DAGOR_GAME_RENDERER)
  list(APPEND AllSrcFolder_CPP render render/objects render/placers)
  set(AllSrcFolder_ES render render/objects render/placers)
  dagor_glob_sources(FILES DIRS ${AllSrcFolder_CPP} GLOB *.cpp)
  dagor_glob_sources(ES_FILES DIRS ${AllSrcFolder_ES} GLOB *ES.cpp.inl)
  # the debug entity systems in Dev and Dbg (with ImGui: CMakeLists.txt)
  dagor_glob_sources(debug DIRS debug debug/placers GLOB *ES.cpp.inl)
  list(TRANSFORM debug REPLACE "^(.+)$" "$<$<CONFIG:Dev,Dbg>:\\1>")
  list(APPEND ES_FILES ${debug})
endif()
