set(AllSrcFolder_ES )
list(APPEND AllSrcFolder_ES common)
if(DAGOR_DEDICATED)
  list(APPEND AllSrcFolder_ES dedicated)
endif()
if(DAGOR_GAME_RENDERER)
  list(APPEND AllSrcFolder_ES render)
endif()
dagor_glob_sources(ES_FILES DIRS ${AllSrcFolder_ES} GLOB *ES.cpp.inl)
if(DAGOR_GAME_RENDERER)
  # the debug entity systems in Dev and Dbg
  dagor_glob_sources(debug DIRS render/debug GLOB *ES.cpp.inl)
  list(TRANSFORM debug REPLACE "^(.+)$" "$<$<CONFIG:Dev,Dbg>:\\1>")
  list(APPEND ES_FILES ${debug})
endif()
